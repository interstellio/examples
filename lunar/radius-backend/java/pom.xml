<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example RADIUS backend (Spring Boot). The only declared dependency is
  spring-boot-starter-web, which pulls in Spring MVC and the embedded Tomcat
  server. The MS-CHAP crypto (MD4 and DES) is implemented on top of the JDK in
  the auth package, so there are no third-party crypto libraries to add.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>io.interstellio</groupId>
    <artifactId>radius-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>radius-backend</name>
    <description>Example RADIUS backend for Lunar (Spring Boot)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
